# =============================================================================
# IPTV Home Gateway — variables d'environnement
# Copiez ce fichier en `.env` : cp .env.example .env
# =============================================================================

# ---------------------------------------------------------------- Base de donnees
POSTGRES_USER=iptv
POSTGRES_PASSWORD=34db187a15058141c77ecd144a33c2a7
POSTGRES_DB=iptv_gateway
# Utilise postgres:5432 (compose) en local, localhost:5432 hors Docker
DATABASE_URL=postgresql://iptv:34db187a15058141c77ecd144a33c2a7@postgres:5432/iptv_gateway?schema=public&connection_limit=20&pool_timeout=15

# ---------------------------------------------------------------- Redis
REDIS_URL=redis://redis:6379
# Mot de passe Redis (optionnel, laissez vide si non utilise)
REDIS_PASSWORD=
REDIS_DB=0

# ---------------------------------------------------------------- Chiffrement
# AES-256-GCM des identifiants upstream. Generez avec :
#   openssl rand -base64 32
# 32 octets decodees en base64. NE CHANGEZ PAS cette valeur apres le premier usage.
ENCRYPTION_KEY=lE3cRJ3uBicl6X6q4dW36+0HHEh69J2dvOpgyMoDK9g=

# ---------------------------------------------------------------- JWT (panel admin)
# Generez avec : openssl rand -hex 48
JWT_SECRET=962a0f67f5df0945ab3a721757ac74a04088232e1d596b6efa3bd9744e0014a5fc9805a956165443d606d651086e6d9b
JWT_REFRESH_SECRET=a7835abf53dfc9b77ef33ec46cdb10dee0a9ebfabeda8a3e1257e6e2e6b020b7b050923c289b17f1a0ffe7ff7f765ee9
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------------------------------------------------------------- API
NODE_ENV=production
API_PORT=3000
API_GLOBAL_PREFIX=
# Origines autorisees (CORS) separees par des virgules
CORS_ORIGINS=http://localhost:8080,http://localhost:3001
# URL publique utilisee pour construire les URLs de flux dans les playlists
PUBLIC_BASE_URL=http://localhost:8080

# ---------------------------------------------------------------- Bootstrap admin
# Compte admin cree au premier demarrage (si aucun admin existe)
ADMIN_EMAIL=admin@iptv.local
ADMIN_PASSWORD=change_me_admin
ADMIN_DISPLAY_NAME=Administrateur

# ---------------------------------------------------------------- Politiques de connexion
# REJECT | EVICT_OLDEST  (comportement quand la limite est atteinte)
TICKET_OVERFLOW_POLICY=REJECT
UPSTREAM_OVERFLOW_POLICY=REJECT
# Nombre max de sessions client par ticket
DEFAULT_TICKET_MAX_CONNECTIONS=1
# Limite de connexions upstream du compte source (detectee via player_api.php)
DEFAULT_MAX_CONNECTIONS=1

# ---------------------------------------------------------------- Rate limiting / anti brute-force
# Fenetre de la fenetre de comptage (secondes)
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX_REQUESTS=120
# Anti brute-force sur player_api.php (par IP + par identifiant)
LOGIN_RATE_WINDOW_SEC=300
LOGIN_RATE_MAX_ATTEMPTS=10
LOGIN_RATE_BLOCK_SEC=300
# Tentatives de login admin avant blocage du compte
ADMIN_MAX_FAILED_LOGINS=8
ADMIN_LOCK_MINUTES=15

# ---------------------------------------------------------------- Streaming
# Nombre max de clients par flux partage (fan-out) sur une instance
STREAM_MAX_CLIENTS_PER_FEED=500
# Timeout d'inactivite d'un flux (secondes sans octet recu)
STREAM_IDLE_TIMEOUT_SEC=90
# Taille des chunks de diffusion inter-noeuds (octets)
STREAM_RELAY_CHUNK_SIZE=32768
# Identifiant unique de l'instance (genere au demarrage si absent)
INSTANCE_ID=

# ---------------------------------------------------------------- Content sync
# Intervalle de synchronisation du catalogue (cron)
CONTENT_SYNC_CRON=*/30 * * * *
# Intervalle de synchronisation de l'EPG (cron)
EPG_SYNC_CRON=15 */2 * * *
# Cron de desactivation des tickets expires
TICKET_EXPIRY_CRON=*/5 * * * *

# ---------------------------------------------------------------- Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8080
WEB_PORT=3001

# ---------------------------------------------------------------- Nginx
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443
# Dossier contenant les certificats (optionnel, HTTPS desactive si absent)
NGINX_CERT_PATH=./nginx/certs

# ---------------------------------------------------------------- Divers
TZ=Europe/Paris
LOG_LEVEL=log
